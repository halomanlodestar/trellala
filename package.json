{
  "name": "trellala",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @trellala/web dev",
    "dev:worker": "bun --filter @trellala/worker dev",
    "build": "bun --filter @trellala/web build",
    "lint": "bun --filter @trellala/web lint",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter @trellala/core test",
    "postinstall": "bun run --cwd packages/db generate",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:migrate:create": "bun run --cwd packages/db migrate:create",
    "db:deploy": "bun run --cwd packages/db deploy",
    "db:reset": "bun run --cwd packages/db reset",
    "db:status": "bun run --cwd packages/db status",
    "db:seed": "bun run --cwd packages/db seed",
    "db:seed:demo": "bun run --cwd packages/db seed:demo",
    "db:studio": "bun run --cwd packages/db studio"
  },
  "packageManager": "bun@1.3.6",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver",
    "prisma",
    "@prisma/engines"
  ]
}
